{
  "name": "pragyan-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/studio",
    "packages/*",
    "remotion-service"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,worker,studio \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:studio\"",
    "dev:api": "tsx services/api/local.ts",
    "dev:worker": "tsx services/workers/local.ts",
    "dev:studio": "npm run dev -w @pragyan/studio",
    "test": "tsx --test tests/workflow.test.ts tests/infra.test.ts",
    "typecheck": "tsc --noEmit && npm run typecheck -w @pragyan/studio",
    "build": "npm run build -w @pragyan/studio",
    "synth": "cdk synth --app \"npx tsx infra/app.ts\"",
    "bundle:workers": "tsx scripts/build-workers.ts",
    "verify:local": "tsx scripts/verify-local.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.900.0",
    "@aws-sdk/client-dynamodb": "^3.900.0",
    "@aws-sdk/client-polly": "^3.900.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/client-secrets-manager": "^3.900.0",
    "@aws-sdk/client-sqs": "^3.900.0",
    "@aws-sdk/cloudfront-signer": "^3.900.0",
    "@aws-sdk/lib-dynamodb": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@codegenie/serverless-express": "^4.17.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-gujarati": "^5.3.0",
    "@fontsource/noto-sans-gurmukhi": "^5.3.0",
    "@fontsource/noto-sans-kannada": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "@remotion/bundler": "4.0.533",
    "@remotion/lambda": "4.0.533",
    "@remotion/player": "4.0.533",
    "@remotion/renderer": "4.0.533",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "katex": "0.19.0",
    "music-metadata": "^11.9.0",
    "pdfjs-dist": "4.10.38",
    "prism-react-renderer": "^2.4.1",
    "proper-lockfile": "^4.1.2",
    "react": "19.1.6",
    "react-dom": "19.1.6",
    "remotion": "4.0.533",
    "zod": "3.25.76",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1147.0",
    "@types/aws-lambda": "^8.10.152",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.18.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.3",
    "amazon-cognito-identity-js": "^6.3.20",
    "aws-cdk": "^2.1033.0",
    "aws-cdk-lib": "2.272.0",
    "concurrently": "^9.2.1",
    "constructs": "^10.4.2",
    "esbuild": "^0.25.10",
    "prettier": "^3.9.9",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "8.5.29"
  }
}
