# Copy to .env at the repository root for API / workers. No real credentials here.
RUNTIME=local
DATA_DIR=.local
APP_ORIGIN=http://localhost:3000
PUBLIC_API_ORIGIN=http://127.0.0.1:4000
EXPORTS_ENABLED=true
LOCAL_TTS=system
LOCAL_FAIL_NARRATION=0

# AWS settings are injected by CDK. Never place access keys in frontend variables.
# AWS_REGION=us-east-1
# TABLE_NAME=
# MEDIA_BUCKET=
# COGNITO_POOL_ID=
# COGNITO_CLIENT_ID=
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# REMOTION_FUNCTION=
# REMOTION_BUCKET=
# REMOTION_SITE=
# WEBHOOK_SECRET_ARN=
# CALLBACK_URL=
# SARVAM_SECRET_ARN=
# USE_CLOUDFRONT=false
# CLOUDFRONT_DOMAIN=
# CLOUDFRONT_KEY_PAIR_ID=
# MEDIA_SIGNER_SECRET_ARN=
# QUEUE_PREPARE=
# QUEUE_NARRATE=
# QUEUE_RENDER=
# QUEUE_COMPLETION=
