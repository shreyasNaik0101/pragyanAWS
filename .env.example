# Gyan_Intent Environment Configuration

# Application
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/gyanintent
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI APIs
OPENAI_API_KEY=sk-your-openai-key-here
SARVAM_API_KEY=sk-your-sarvam-key-here

# WhatsApp Bot (whatsapp-web.js)
WHATSAPP_BOT_URL=http://localhost:3003

# Remotion renderer
REMOTION_SERVICE_URL=http://localhost:3005

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Video Generation
VIDEO_OUTPUT_DIR=./media/output
VIDEO_TEMP_DIR=./media/temp
MAX_VIDEO_DURATION=120
