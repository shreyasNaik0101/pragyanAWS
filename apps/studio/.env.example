# Local defaults need no environment file.
NEXT_PUBLIC_RUNTIME=local
NEXT_PUBLIC_API_ORIGIN=
API_ORIGIN=http://127.0.0.1:4000

# Future AWS build-time values (not secrets)
# NEXT_PUBLIC_RUNTIME=aws
# NEXT_PUBLIC_API_ORIGIN=https://your-api.execute-api.us-east-1.amazonaws.com
# NEXT_PUBLIC_COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com
# NEXT_PUBLIC_COGNITO_CLIENT_ID=
